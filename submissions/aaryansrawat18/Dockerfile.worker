# Worker image. Same libraries and MiniLM weights as the API.
# The command is the RQ worker class that requeues stuck jobs and writes the heartbeat.

FROM python:3.12-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV HF_HOME=/opt/model-cache
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=builder /usr/local /usr/local
COPY --from=builder /opt/model-cache /opt/model-cache
COPY app ./app

RUN mkdir -p /data/uploads \
    && chown -R appuser:appuser /opt/model-cache /data/uploads /app

ENV HF_HOME=/opt/model-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER appuser
# Shell form so REDIS_URL from the environment is used at start, not at build.
CMD rq worker --url "$REDIS_URL" --worker-class app.worker.IngestWorker
