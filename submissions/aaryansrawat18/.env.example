# Fill JWT_SECRET and GEMINI_API_KEY before `docker compose up`.
# Compose sets DATABASE_URL, REDIS_URL, and the upload folder inside the containers.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_MODEL=
SIMILARITY_THRESHOLD=
# Used only by eval/run_eval.py. Leave blank to run the app.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documind-eval
LANGSMITH_TRACING=true
