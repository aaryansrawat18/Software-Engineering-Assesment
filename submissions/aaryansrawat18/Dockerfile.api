# API image. The builder installs Python packages and downloads MiniLM.
# The final image is slim, runs as a normal user, and has no secrets.

FROM python:3.12-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Save the embedding model in the image so a running container does not call Hugging Face.
ENV HF_HOME=/opt/model-cache
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=builder /usr/local /usr/local
COPY --from=builder /opt/model-cache /opt/model-cache
COPY app ./app
COPY ui ./ui

# The named volume is first created from this folder, owned by appuser.
RUN mkdir -p /data/uploads \
    && chown -R appuser:appuser /opt/model-cache /data/uploads /app

ENV HF_HOME=/opt/model-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
